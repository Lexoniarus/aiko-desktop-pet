# Normalize source text to LF; never reinterpret binary media as text.
* text=auto
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.png -text
*.gif -text
*.jpg -text
*.jpeg -text
*.webp -text
*.svg text eol=lf
*.ico -text
*.woff -text
*.woff2 -text

# Preserve the imported runtime source export byte-for-byte, including text.
assets/aiko-anime-8-frames/aiko-anime-compact/** -text -eol
assets/aiko-pick-up/** -text -eol
