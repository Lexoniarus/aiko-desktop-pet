{
  "name": "aiko-shared-room",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "build": "tsc --noEmit && vite build --config vite.starter.config.ts && vite build --config vite.runtime.config.ts && node scripts/build-service-worker.mjs",
    "preview": "vite preview --config vite.starter.config.ts --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "package": "python ../scripts/build_room_package.py"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "pixi.js": "8.22.0",
    "pixi-viewport": "7.0.0",
    "pyodide": "314.0.7",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "workbox-build": "7.4.1"
  }
}
