# Aiko Desktop Pet — optional local configuration
#
# No credentials or API keys are required. Aiko runs without a .env file.
# To override the save file location, copy this file to .env and fill in the
# value below. Existing OS environment variables take precedence over .env.
#
# Windows example (uncomment to use):
# AIKO_SAVE_PATH=C:/Users/YourName/AppData/Local/AikoDesktopPet/state.json
#
# Linux example (uncomment to use):
# AIKO_SAVE_PATH=/home/yourname/.local/share/AikoDesktopPet/state.json
#
# With an empty value, Aiko uses its existing OS-specific default location.
AIKO_SAVE_PATH=
